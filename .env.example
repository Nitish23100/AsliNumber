# AsliNumber environment configuration template.
# Copy this file to .env and fill in real values. Never commit .env.

# ------------------------------------------------------------
# Core application (Requirement 14.1)
# ------------------------------------------------------------
APP_ENV=development

# MongoDB
# Local:  mongodb://localhost:27017/aslinumber
# Atlas:  mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/<DB_NAME>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/aslinumber

# SerpApi (required only for live collection; replay mode works without it)
SERPAPI_API_KEY=

# ------------------------------------------------------------
# Runtime / feature flags
# ------------------------------------------------------------
REPLAY_MODE=true
DEMO_MODE=true
PUBLIC_MODE=true
LIVE_COLLECTION=false

# Credit guard
MAX_CREDITS_PER_SWEEP=120
CREDIT_FLOOR=20

# Worker / queue
WORKER_CONCURRENCY=2

# ------------------------------------------------------------
# Authentication / encryption
# Generate strong random values for these locally. Never reuse the
# placeholder below in any real environment.
# JWT_SECRET: long random secret string (32+ bytes recommended).
# FERNET_KEY: a valid Fernet key (32 url-safe base64-encoded bytes).
# ------------------------------------------------------------
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET
FERNET_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY

# ------------------------------------------------------------
# LLM / summaries (Groq) -- Requirement 14.2
# Groq provides an OpenAI-compatible API. Declared here but unused until
# a later phase (F24 summaries); see docs/aslinumber-implementation-plan.md
# for the architecture decision to use Groq instead of a local LLM.
# ------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30

# ------------------------------------------------------------
# Frontend / API
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------
# Startup safety guard (Requirement 11)
# ------------------------------------------------------------
BIND_HOST=127.0.0.1
READ_ONLY=false

# ------------------------------------------------------------
# Optional development overrides
# ------------------------------------------------------------
# API_HOST=127.0.0.1
# API_PORT=8000
# WEB_PORT=5173
# MONGO_DB_NAME=aslinumber
# DEMO_PASSWORD=

# ------------------------------------------------------------
# Notes
# ------------------------------------------------------------
# 1. Keep .env local and git-ignored; this file (.env.example) is the
#    only one meant to be committed.
# 2. Replay mode should work without a SerpApi key.
# 3. Set LIVE_COLLECTION=false for a hosted judge/demo environment unless
#    you are intentionally running a live sweep.
# 4. DEMO_MODE=true refuses to start unless BIND_HOST=127.0.0.1 or
#    READ_ONLY=true (Requirement 11) -- this protects seeded demo
#    credentials from being exposed on a public network interface.
# 5. Alert-channel credentials (SMTP/Slack/Telegram) are configured
#    through the application and encrypted in MongoDB, not hardcoded here.